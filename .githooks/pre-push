#!/bin/sh
# Prevent accidental publication of the retained pre-reboot history.
old_head=$(git rev-parse --verify refs/tags/archive/pre-reboot-2026-11-19 2>/dev/null)
while read local_ref local_oid remote_ref remote_oid
do
  case "$local_ref" in
    refs/tags/archive/*|refs/heads/task/*)
      echo "Blocked: old branches and archive tags must remain local." >&2
      exit 1
      ;;
  esac
  if [ -n "$old_head" ] && git cat-file -e "$local_oid^{commit}" 2>/dev/null && git merge-base --is-ancestor "$old_head" "$local_oid"
  then
    echo "Blocked: this ref contains old project history." >&2
    exit 1
  fi
done
